#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage:
  research-memory-enable [--root DIR] [--client DIR] [--config FILE] [--profile NAME]

Prepare a local research-memory bundle and write config/research-memory.env.
Run this only on the Docker host, not inside a Dolphin container. It creates
symlinks and an ignored path-only overlay; it never copies or prints key data.
EOF
}

die() {
  printf 'research-memory-enable: %s\n' "$*" >&2
  exit 2
}

[[ ! -f /.dockerenv ]] || die "run this from the Dolphin checkout on the Docker host"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
CONFIG_DIR="${REPO_DIR}/config"
OVERLAY_FILE="${CONFIG_DIR}/research-memory.env"
DEFAULT_ROOT="${XDG_CONFIG_HOME:-${HOME}/.config}/dolphin/research-memory"
DEFAULT_CLIENT="${REPO_DIR}/../track-research-history/client"
DEFAULT_CONFIG="${XDG_CONFIG_HOME:-${HOME}/.config}/research-memory/client.json"

root="${DEFAULT_ROOT}"
client="${DEFAULT_CLIENT}"
config="${DEFAULT_CONFIG}"
profile=""

while (($#)); do
  case "$1" in
    --root)
      (($# >= 2)) || die "--root requires a directory"
      root="$2"
      shift 2
      ;;
    --client)
      (($# >= 2)) || die "--client requires a directory"
      client="$2"
      shift 2
      ;;
    --config)
      (($# >= 2)) || die "--config requires a file"
      config="$2"
      shift 2
      ;;
    --profile)
      (($# >= 2)) || die "--profile requires a name"
      profile="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      die "unknown option: $1"
      ;;
  esac
done

if [[ -d "${root}" && -L "${root}/client" && -L "${root}/client.json" && \
      -L "${root}/id_ed25519" && -L "${root}/known_hosts" ]]; then
  [[ -z "${profile}" ]] || \
    die "an existing root has a fixed default profile; use a new --root to switch profiles"
else
  init_args=(--root "${root}" --client "${client}" --config "${config}")
  if [[ -n "${profile}" ]]; then
    init_args+=(--profile "${profile}")
  fi
  "${SCRIPT_DIR}/research-memory-init" "${init_args[@]}"
fi

root="$(cd -P "${root}" && pwd -P)"
umask 077
overlay_tmp="$(mktemp "${CONFIG_DIR}/.research-memory.env.XXXXXX")"
trap 'rm -f "${overlay_tmp}"' EXIT
printf '# Generated by scripts/research-memory-enable. Do not commit.\nRESEARCH_MEMORY_ROOT=%q\n' "${root}" > "${overlay_tmp}"
mv -f "${overlay_tmp}" "${OVERLAY_FILE}"
trap - EXIT

printf 'Local overlay written: %s\n' "${OVERLAY_FILE}"
printf 'Rebuild the image, then recreate the container before using shared memory.\n'
