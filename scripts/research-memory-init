#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage:
  research-memory-init --root DIR --client DIR --config FILE [--profile NAME]

Create the one-directory Dolphin runtime layout with symlinks to an existing
research-memory client, non-secret profile config, SSH key, known_hosts, and
optional SSH config. No key material is copied or printed.

Without --profile, the config's existing default profile is used. With
--profile, that profile is selected as the config's default before linking.
EOF
}

die() {
  printf 'research-memory-init: %s\n' "$*" >&2
  exit 2
}

expand_home() {
  local value="$1"
  if [[ "${value}" == "~/"* ]]; then
    printf '%s/%s\n' "${HOME}" "${value:2}"
  else
    printf '%s\n' "${value}"
  fi
}

absolute_dir() {
  local label="$1"
  local value
  value="$(expand_home "$2")"
  [[ -d "${value}" ]] || die "${label} must be an existing directory: ${value}"
  (
    cd -P -- "${value}"
    pwd -P
  )
}

absolute_file() {
  local label="$1"
  local value
  value="$(expand_home "$2")"
  [[ -f "${value}" && -r "${value}" ]] || \
    die "${label} must be a readable file: ${value}"
  (
    cd -P "$(dirname "${value}")"
    printf '%s/%s\n' "$(pwd -P)" "$(basename "${value}")"
  )
}

root=""
client=""
config=""
profile=""

while (($#)); do
  case "$1" in
    --root)
      (($# >= 2)) || die "--root requires a directory"
      root="$2"
      shift 2
      ;;
    --client)
      (($# >= 2)) || die "--client requires a directory"
      client="$2"
      shift 2
      ;;
    --config)
      (($# >= 2)) || die "--config requires a file"
      config="$2"
      shift 2
      ;;
    --profile)
      (($# >= 2)) || die "--profile requires a name"
      profile="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      die "unknown option: $1"
      ;;
  esac
done

[[ -n "${root}" ]] || die "--root is required"
[[ -n "${client}" ]] || die "--client is required"
[[ -n "${config}" ]] || die "--config is required"

client="$(absolute_dir --client "${client}")"
[[ -f "${client}/memctl.py" && -f "${client}/profiles.py" ]] || \
  die "--client must contain memctl.py and profiles.py"
config="$(absolute_file --config "${config}")"

if [[ -n "${profile}" ]]; then
  python3 "${client}/memctl.py" --config "${config}" profile use "${profile}" >/dev/null
fi

profile_args=(--config "${config}")
identity="$(python3 "${client}/profiles.py" get "${profile_args[@]}" --field identity_file)"
known_hosts="$(python3 "${client}/profiles.py" get "${profile_args[@]}" --field known_hosts)"
ssh_config="$(python3 "${client}/profiles.py" get "${profile_args[@]}" --field ssh_config --optional)"

identity="$(absolute_file 'default profile identity_file' "${identity}")"
known_hosts="$(absolute_file 'default profile known_hosts' "${known_hosts}")"
if [[ -n "${ssh_config}" ]]; then
  ssh_config="$(absolute_file 'default profile ssh_config' "${ssh_config}")"
fi

root="$(expand_home "${root}")"
if [[ -e "${root}" || -L "${root}" ]]; then
  [[ -d "${root}" && ! -L "${root}" ]] || \
    die "--root must be a real directory, not a file or symlink: ${root}"
else
  install -d -m 0700 "${root}"
fi
root="$(absolute_dir --root "${root}")"

names=(client client.json id_ed25519 known_hosts)
sources=("${client}" "${config}" "${identity}" "${known_hosts}")
if [[ -n "${ssh_config}" ]]; then
  names+=(ssh_config)
  sources+=("${ssh_config}")
fi

for name in "${names[@]}"; do
  [[ ! -e "${root}/${name}" && ! -L "${root}/${name}" ]] || \
    die "refusing to replace existing ${root}/${name}"
done

for index in "${!names[@]}"; do
  ln -s "${sources[index]}" "${root}/${names[index]}"
done

printf 'Research-memory runtime root prepared: %s\n' "${root}"
printf 'Set RESEARCH_MEMORY_ROOT=%s in config/runtime.env, then rebuild/recreate Dolphin.\n' "${root}"
