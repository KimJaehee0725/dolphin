IMAGE_NAME=jaehee-base:0428
DOCKERFILE_PATH=Dockerfile
BUILD_CONTEXT_DIR=.
NO_CACHE=0

CONTAINER_NAME=jaehee-dev
AUTO_RECREATE=0

WORKSPACE_DIR=/workspace
VOLUMES="/home/jaeheekim/codes:/workspace/codes /data1/jaehee:/data1"
EXTRA_VOLUMES=
PORTS="9208:9208 9450:9450"
MOUNT_DOCKER_SOCKET=1

# Optional auth values. Leave blank to skip that auth setup.
GITHUB_TOKEN=
GH_TOKEN=
HF_TOKEN=
HUGGINGFACE_TOKEN=
WANDB_API_KEY=

# Optional personal Research Memory password mode. Leave all three blank to
# disable it. The real runtime.env is ignored; never commit its password.
RESEARCH_MEMORY_HOST=
RESEARCH_MEMORY_USER=memory-rpc
RESEARCH_MEMORY_PASSWORD=
# Empty: the agent lists projects and asks which memory to use. Set an ID to
# select one automatically for every new container.
RESEARCH_MEMORY_PROJECT=
