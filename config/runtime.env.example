IMAGE_NAME=jaehee-base:0428
DOCKERFILE_PATH=Dockerfile
BUILD_CONTEXT_DIR=.
NO_CACHE=0

CONTAINER_NAME=jaehee-dev
AUTO_RECREATE=0

WORKSPACE_DIR=/workspace
VOLUMES="/home/jaeheekim/codes:/workspace/codes /data1/jaehee:/data1"
EXTRA_VOLUMES=
PORTS="9208:9208 9450:9450"
MOUNT_DOCKER_SOCKET=1

# Optional central research-memory client. Set RESEARCH_MEMORY_ENABLED=1 only after making a
# project-scoped memctl profile. These values are paths and a profile name, not
# key contents. RESEARCH_MEMORY_KNOWN_HOSTS is required when enabled.
RESEARCH_MEMORY_ENABLED=0
RESEARCH_MEMORY_PROFILE=
RESEARCH_MEMORY_CLIENT_DIR=
RESEARCH_MEMORY_CONFIG=
RESEARCH_MEMORY_IDENTITY_FILE=
RESEARCH_MEMORY_KNOWN_HOSTS=
# Leave blank unless the selected SSH host/profile needs an OpenSSH config.
RESEARCH_MEMORY_SSH_CONFIG=

# Optional auth values. Leave blank to skip that auth setup.
GITHUB_TOKEN=
GH_TOKEN=
HF_TOKEN=
HUGGINGFACE_TOKEN=
WANDB_API_KEY=
