IMAGE_NAME=jaehee-base:latest
CONTAINER_NAME=jaehee-dev
WORKSPACE_DIR=/workspace
VOLUMES="/home/jaeheekim/codes:/workspace/codes /data1/jaehee:/data1"
PORTS="9208:9208 9450:9450"
MOUNT_DOCKER_SOCKET=0

# Optional tool credentials. The launcher stores non-empty values in private
# container-local files and removes stale files for empty values.
GITHUB_TOKEN=
HF_TOKEN=
WANDB_API_KEY=
# Issued by the DSBA LiteLLM administrator.
DSBA_LITELLM_API_KEY=
