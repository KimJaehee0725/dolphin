# 빌드할 Docker 이미지 이름과 태그.
IMAGE_NAME=jaehee-base:latest
# 생성하거나 재사용할 컨테이너 이름. 컨테이너 hostname에도 적용.
CONTAINER_NAME=jaehee-dev
# 컨테이너 쉘의 시작 경로. 컨테이너 안에 존재하는 경로 사용.
WORKSPACE_DIR=/workspace
# 디렉터리 연결 목록. 형식: 호스트경로:컨테이너경로[:ro]. 공백 또는 쉼표로 구분.
# 아래 호스트 경로는 사용하는 서버나 Mac의 실제 경로로 변경.
VOLUMES="/home/jaeheekim/codes:/workspace/codes /data1/jaehee:/data1"
# 포트 연결 목록. 형식: 호스트포트:컨테이너포트. 공백 또는 쉼표로 구분.
PORTS="9208:9208 9450:9450"
# 호스트 Docker 소켓 연결 여부. 0: 연결 안 함, 1: 연결함.
MOUNT_DOCKER_SOCKET=0

# 선택적 인증값. 빈 값이면 컨테이너의 해당 인증 파일 삭제.
# 입력한 값은 컨테이너 내부의 권한 600 파일로 전달.
# 아래 주석의 키는 형식 설명용 가짜 예시. 실제 발급값은 runtime.env에만 입력.

# GitHub CLI와 비공개 Git 저장소 접근용 토큰.
# classic PAT 형식 예시: ghp_EXAMPLE00000000000000000000000000000
GITHUB_TOKEN=
# Hugging Face 모델과 데이터셋 접근용 토큰.
# 형식 예시: hf_EXAMPLE000000000000000000000000000
HF_TOKEN=
# Weights & Biases 실험 기록용 API 키.
# 40자리 키 형식 예시: 0123456789abcdef0123456789abcdef01234567
WANDB_API_KEY=
# DSBA LiteLLM 모델 API 키. 관리자에게 발급받은 값 사용.
# 형식 예시: sk-0123456789abcdef0123456789abcdef
DSBA_LITELLM_API_KEY=
# DSBA 서버 포탈에서 발급한 개인 API 토큰. 조회는 read, 예약과 반납은 write 권한 필요.
# 형식 예시: dsba_pat_EXAMPLE0123456789abcdefghijklmnopqrstuvwxyz
DSBA_PORTAL_TOKEN=
